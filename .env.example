# Copy this file to server/.env for local development.
# Never commit server/.env or put private values in VITE_* variables.
PORT=4000
SCHOOL_TIMEZONE=Asia/Kolkata
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production requires a cryptographically random secret of at least 32 characters.
# Generate one locally: node -e "process.stdout.write(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Optional locally; mandatory for deployed/production API persistence.
# Use a separate database for staging and production.
DATABASE_URL=

# Local demo account only. Production never seeds demo accounts.
# Set a private override before creating a fresh local demo database.
CAMPUSOS_DEMO_STAFF_PASSWORD=

# Optional server-only account provisioning, generated by configure:portals.
# Encodes a bcrypt hash and a revision; never use a VITE_ prefix or commit a value.
CAMPUSOS_SHARED_PORTAL_ACCOUNTS=
